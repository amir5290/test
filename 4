| search ((resourceType = "caseManagement") and (status = "Approved and Close"))
| fields key, created, updated, endTime as scenarioRECVTime
| eval start_time := 2026-08-23 00:00:00, end_time := 2026-11-25 23:59:59
| eval created_start := relativeTime(start_time, '-60d')
| search ((created >= created_start) and (created <= end_time))
| fields key, created, updated, scenarioRECVTime, start_time, end_time
| eval closed_time := GetStatusChangedTime(key, "Approved and Close")
| search ((closed_time >= start_time) and (closed_time <= end_time) and (created <= closed_time))
| eval MTTA := case(scenarioRECVTime != null, round((toUnixTime(created)-toUnixTime(scenarioRECVTime))/60))
| stats avg(MTTA) as MTTA
| eval MTTA := round(MTTA)
