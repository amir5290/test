| search ((resourceType = "caseManagement") and (status = "Approved and Close"))
| eval start_time := 2026-03-21 00:00:00, end_time := 2026-06-21 23:59:59
| eval created_start := relativeTime(start_time, '-60d')
| search ((created >= created_start) and (created <= end_time))
| fields key, created, updated, start_time, end_time
| eval closed_time := GetStatusChangedTime(key, "Approved and Close")
| search ((closed_time >= start_time) and (closed_time <= end_time) and (created <= closed_time))
| eval target := GetStatusChangedTime(key, "Containment")
| search (target != null)
| join (@outer.key = @inner.key)
    [
        | datasource "resource_history" ApplyParentTimeRange := false
        | search (evantname ~ "statuschange")
        | search not isNullOrEmpty(key)
        | eval history_start := relativeTime(2026-03-21 00:00:00, '-60d'), history_end := 2026-06-21 23:59:59
        | search ((eventtime >= history_start) and (eventtime <= history_end))
        | search (newstatusname in ("Declined", "Containment", "Missconfiguration"))
        | eval eventtime_u := tounixtime(eventtime), statusName := case((newstatusname = "Declined"), "inDeclined", (newstatusname = "Containment"), "inContainment", (newstatusname = "Missconfiguration"), "inMissconfiguration")
        | sort -key, -eventtime_u
        | fields key, statusName
        | mvcombine statusName
        | search (mvselect(statusName, 0) = "inContainment")
        | fields key
    ]
| join (@outer.key = @inner.key)
    [
        | datasource "resource_history" ApplyParentTimeRange := false
        | search (evantname ~ "statuschange")
        | search not isNullOrEmpty(key)
        | eval history_start := relativeTime(2026-03-21 00:00:00, '-60d'), history_end := 2026-06-21 23:59:59
        | search ((eventtime >= history_start) and (eventtime <= history_end))
        | search (newstatusname = "Containment")
        | eval containment_time := tounixtime(eventtime)
        | stats min(containment_time) as containment_time by key
        | join (@outer.key = @inner.key)
            [
                | datasource "resource_history" ApplyParentTimeRange := false
                | search (evantname ~ "statuschange")
                | search not isNullOrEmpty(key)
                | eval history_start := relativeTime(2026-03-21 00:00:00, '-60d'), history_end := 2026-06-21 23:59:59
                | search ((eventtime >= history_start) and (eventtime <= history_end))
                | search (newstatusname = "Waiting for Approval")
                | eval waiting_time := tounixtime(eventtime)
                | fields key, waiting_time
            ]
        | search (waiting_time > containment_time)
        | stats min(waiting_time) as first_waiting, min(containment_time) as first_containment by key
        | eval mttr := ((first_waiting - first_containment) / 60)
        | fields key, first_containment, first_waiting, mttr
    ]
| stats avg(mttr) as MTTR
| eval MTTR := round(MTTR, 2)
